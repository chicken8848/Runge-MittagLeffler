module

public import Conway.Runge
public import Mathlib.Analysis.Normed.Module.Connected
public import Mathlib.LinearAlgebra.Complex.FiniteDimensional

/-!
# MA5217 / Conway Chapter VIII, §1: Runge's theorem on an open set (Conway VIII.1.14, VIII.1.15)

This file contains the two corollaries the lecturer states at the end of lecture 14: Runge's theorem
for functions holomorphic on an *open* set `G`, with approximation uniform on compact subsets of
`G` (`Conway.runge_open`), and its polynomial form (`Conway.runge_open_polys`, Conway VIII.1.15,
"take `E = {∞}`").

The proof is the lecturer's, in two steps (lecture 14 p.4 and lecture 15 p.1-2):

1. the *compact exhaustion* `Conway.exh` of the open set `G` (the Compact Exhaustion Lemma of
   lecture 15: `Kₙ := B̄(0; n) ∩ {z : d(z, ℂ − G) ≥ 1/n}`, with `Kₙ ⊆ interior Kₙ₊₁`,
   `G = ⋃ n, Kₙ`, `Kₙ` compact, and every compact subset of `G` inside some `interior Kₙ`);
2. Runge's theorem `Conway.runge` applied to `Kₙ` with `ε := 1/(n+2)`, the approximations being
   lifted to rational functions on all of `ℂ` by `Conway.exists_ratFun_of_mem_RatAlgOn` and pasted
   together.

Since `Conway.runge` is the only input, the same two axioms as for Runge's theorem —
`Conway.enhancedSeparationLemma` and `Conway.exists_poleChain_of_sameComponent` — are the only
axioms used here beyond the standard ones.
-/

@[expose] public section


open Set Filter TopologicalSpace Metric
open scoped BigOperators

namespace Conway

noncomputable section

variable {G : Set ℂ} {E : Set ℂ} {atInfinity : Bool}

/-! ## Rational functions as functions on all of `ℂ` -/

/-- The global version of the generator `z ↦ (z - a)⁻¹` of `Conway.RatAlg`. -/
def ratFunInv (a : ℂ) : ℂ → ℂ := fun z ↦ (z - a)⁻¹

/-- The global coordinate function `z ↦ z`, i.e. the generator with a pole at `∞`. -/
def ratFunId : ℂ → ℂ := fun z ↦ z

/-- `RatFun E atInfinity` is the ℂ-subalgebra of `ℂ → ℂ` generated by the functions
`z ↦ (z - a)⁻¹` (`a ∈ E`) and, if `atInfinity`, by `z ↦ z`: the rational functions on `ℂ∞` whose
poles lie in `E ∪ {∞ if atInfinity}`, seen as functions on `ℂ`.  This is the version of
`Conway.RatAlgOn` that does not depend on a compact set, needed to state the pole set of a
*sequence* of approximating rational functions (the lecturer's Corollaries 1.14 and 1.15). -/
def RatFun (E : Set ℂ) (atInfinity : Bool) : Subalgebra ℂ (ℂ → ℂ) :=
  Algebra.adjoin ℂ (ratFunInv '' E ∪ if atInfinity then {ratFunId} else ∅)

/-- `PolyFun` is the algebra of polynomial functions on `ℂ`, i.e. `RatFun ∅ true`: the rational
functions whose only pole is `∞` (the lecturer's Corollary 1.15, "take `E = {∞}`"). -/
def PolyFun : Subalgebra ℂ (ℂ → ℂ) := Algebra.adjoin ℂ {ratFunId}

theorem RatFun.mem_of_mem {a : ℂ} (ha : a ∈ E) : ratFunInv a ∈ RatFun E atInfinity :=
  Algebra.subset_adjoin (Set.mem_union_left _ (Set.mem_image_of_mem _ ha))

theorem RatFun.mem_coord (h : atInfinity) : ratFunId ∈ RatFun E atInfinity :=
  Algebra.subset_adjoin (Set.mem_union_right _ (by simpa using h))

theorem RatFun.eq_false : RatFun E false = Algebra.adjoin ℂ (ratFunInv '' E) := by
  change Algebra.adjoin ℂ
    (ratFunInv '' E ∪ (if (false : Bool) then ({ratFunId} : Set (ℂ → ℂ)) else ∅)) =
    Algebra.adjoin ℂ (ratFunInv '' E)
  rw [show (if (false : Bool) then ({ratFunId} : Set (ℂ → ℂ)) else ∅) = ∅ from rfl,
    Set.union_empty]

theorem RatFun.eq_true : RatFun E true = Algebra.adjoin ℂ (ratFunInv '' E ∪ {ratFunId}) := by
  change Algebra.adjoin ℂ
    (ratFunInv '' E ∪ (if (true : Bool) then ({ratFunId} : Set (ℂ → ℂ)) else ∅)) =
    Algebra.adjoin ℂ (ratFunInv '' E ∪ {ratFunId})
  rw [show (if (true : Bool) then ({ratFunId} : Set (ℂ → ℂ)) else ∅) = {ratFunId} from rfl]

theorem RatFun.empty_true : RatFun (∅ : Set ℂ) true = PolyFun := by
  rw [eq_true, Set.image_empty, Set.empty_union, PolyFun]

/-- `restrictImage K A` is the ℂ-subalgebra of `↥K → ℂ` of functions that agree on `K` with a member
of the algebra `A` of functions on `ℂ`.  It is the image of `A` under the restriction homomorphism,
written out in a form that does not use `Subalgebra.map`. -/
def restrictImage (K : Set ℂ) (A : Subalgebra ℂ (ℂ → ℂ)) : Subalgebra ℂ (↥K → ℂ) where
  carrier := {x | ∃ g ∈ A, ∀ z : ↥K, g z = x z}
  mul_mem' := by
    intro x y hx hy
    obtain ⟨g₁, hg₁, h₁⟩ := hx
    obtain ⟨g₂, hg₂, h₂⟩ := hy
    refine ⟨g₁ * g₂, A.mul_mem hg₁ hg₂, fun z ↦ by simp only [Pi.mul_apply, h₁ z, h₂ z]⟩
  add_mem' := by
    intro x y hx hy
    obtain ⟨g₁, hg₁, h₁⟩ := hx
    obtain ⟨g₂, hg₂, h₂⟩ := hy
    refine ⟨g₁ + g₂, A.add_mem hg₁ hg₂, fun z ↦ by simp only [Pi.add_apply, h₁ z, h₂ z]⟩
  zero_mem' := ⟨0, A.zero_mem, fun _ ↦ rfl⟩
  one_mem' := ⟨1, A.one_mem, fun _ ↦ rfl⟩
  algebraMap_mem' := fun r ↦
    ⟨algebraMap ℂ (ℂ → ℂ) r, A.algebraMap_mem r, fun _ ↦ by simp⟩

theorem mem_restrictImage {K : Set ℂ} {A : Subalgebra ℂ (ℂ → ℂ)} {x : ↥K → ℂ} :
    x ∈ restrictImage K A ↔ ∃ g ∈ A, ∀ z : ↥K, g z = x z := Iff.rfl

/-- Every element of `Conway.RatAlgOn E atInfinity K` — i.e. every rational function on `K` whose
poles lie in `E ∪ {∞ if atInfinity}` — belongs to `Conway.restrictImage K (Conway.RatFun E
atInfinity)`: the two algebras of rational functions agree. -/
theorem RatAlgOn_le_restrictImage (K : Set ℂ) :
    RatAlgOn E atInfinity K ≤ restrictImage K (RatFun E atInfinity) := by
  cases atInfinity with
  | false =>
    rw [RatAlgOn_eq_false]
    change Algebra.adjoin ℂ ((fun a ↦ invSub a K) '' E) ≤ restrictImage K (RatFun E false)
    refine Algebra.adjoin_le_iff.mpr (Set.image_subset_iff.mpr fun a ha ↦
      ⟨ratFunInv a, RatFun.mem_of_mem ha, fun z ↦ rfl⟩)
  | true =>
    rw [RatAlgOn_eq_true]
    change Algebra.adjoin ℂ ((fun a ↦ invSub a K) '' E ∪ {coord K}) ≤
      restrictImage K (RatFun E true)
    refine Algebra.adjoin_le_iff.mpr (Set.union_subset_iff.mpr
      ⟨Set.image_subset_iff.mpr fun a ha ↦ ⟨ratFunInv a, RatFun.mem_of_mem ha, fun z ↦ rfl⟩,
        Set.singleton_subset_iff.mpr ⟨ratFunId, RatFun.mem_coord rfl, fun z ↦ rfl⟩⟩)

/-- **Lifting rational functions**: every rational function on `K` whose poles lie in
`E ∪ {∞ if atInfinity}` is the restriction to `K` of an element of `Conway.RatFun E atInfinity`,
i.e. of a rational function on all of `ℂ`. -/
theorem exists_ratFun_of_mem_RatAlgOn {K : Set ℂ} {x : ↥K → ℂ}
    (hx : x ∈ RatAlgOn E atInfinity K) : ∃ g ∈ RatFun E atInfinity, ∀ z : ↥K, g z = x z :=
  RatAlgOn_le_restrictImage K hx

/-! ## The compact exhaustion of an open set (lecture 15 p.1-2) -/

/-- `Conway.WithinComplement G n z`: the condition `1/n ≤ d(z, ℂ − G)` of lecture 15 p.2, written
out as `∀ v ∉ G`, and with `1 / ((n : ℝ) + 2)` in place of `1/n` so that `n = 0` is allowed. -/
def WithinComplement (G : Set ℂ) (n : ℕ) (z : ℂ) : Prop :=
  ∀ v ∉ G, (1 : ℝ) / ((n : ℝ) + 2) ≤ ‖z - v‖

/-- `Conway.exh G n` is the `n`-th member of the lecturer's compact exhaustion of the open set `G`
from lecture 15 p.2: `Kₙ := B̄(0; n) ∩ {z : d(z, ℂ − G) ≥ 1/n}`, with `‖z‖ ≤ (n : ℝ) + 1` in place
of `z ∈ B̄(0; n)` and with `Conway.WithinComplement` for the distance to the complement. -/
def exh (G : Set ℂ) (n : ℕ) : Set ℂ := {z | ‖z‖ ≤ (n : ℝ) + 1 ∧ WithinComplement G n z}

theorem mem_exh {n : ℕ} {z : ℂ} :
    z ∈ exh G n ↔ ‖z‖ ≤ (n : ℝ) + 1 ∧ WithinComplement G n z := Iff.rfl

theorem exh.norm_le {n : ℕ} {z : ℂ} (hz : z ∈ exh G n) : ‖z‖ ≤ (n : ℝ) + 1 := hz.1

theorem exh.withinComplement {n : ℕ} {z : ℂ} (hz : z ∈ exh G n) : WithinComplement G n z := hz.2

theorem exh.mem {n : ℕ} {z : ℂ} (hz1 : ‖z‖ ≤ (n : ℝ) + 1)
    (hz2 : WithinComplement G n z) : z ∈ exh G n := ⟨hz1, hz2⟩

/-- `{z : ‖z‖ ≤ r}` is closed. -/
theorem isClosed_ball_norm {r : ℝ} : IsClosed {z : ℂ | ‖z‖ ≤ r} :=
  isClosed_le continuous_norm continuous_const

/-- `{z : d(z, ℂ − G) ≥ 1/n}` is closed: its complement is the union of the balls of radius `1/n`
centred at the points of `ℂ − G` (lecture 15 p.2). -/
theorem isClosed_withinComplement {n : ℕ} : IsClosed {z : ℂ | WithinComplement G n z} := by
  have h1 : {z : ℂ | WithinComplement G n z}ᶜ =
      ⋃ v ∈ Gᶜ, Metric.ball v ((1 : ℝ) / ((n : ℝ) + 2)) := by
    refine Set.ext fun z ↦ ⟨fun hz ↦ ?_, fun hz ↦ ?_⟩
    · obtain ⟨i, hi⟩ := not_forall.mp hz
      refine Set.mem_iUnion₂.mpr ⟨i, (not_imp.mp hi).1, Metric.mem_ball.mpr ?_⟩
      rw [dist_eq_norm]
      exact not_le.mp ((not_imp.mp hi).2)
    · obtain ⟨v, hv, hv'⟩ := Set.mem_iUnion₂.mp hz
      intro hW
      have h2 := hW v hv
      rw [Metric.mem_ball, dist_eq_norm] at hv'
      exact (not_le.mpr hv') h2
  refine isOpen_compl_iff.mp ?_
  rw [h1]
  exact isOpen_iUnion fun _v ↦ isOpen_iUnion fun _hv ↦ isOpen_ball

/-- The lecturer's "(iii)": each `Kₙ` is compact (lecture 15 p.1). -/
theorem isCompact_exh (n : ℕ) : IsCompact (exh G n) := by
  have h1 : exh G n ⊆ Metric.closedBall (0 : ℂ) ((n : ℝ) + 1) := fun z hz ↦
    Metric.mem_closedBall.mpr (by rw [dist_eq_norm, sub_zero]; exact hz.1)
  have h2 : IsClosed (exh G n) := isClosed_ball_norm.inter isClosed_withinComplement
  exact (isCompact_closedBall (0 : ℂ) _).of_isClosed_subset h2 h1

/-- The lecturer's `Kₙ ⊆ G` (lecture 15 p.2): a point of `Kₙ` is at distance at least `1/n > 0`
from `ℂ − G`. -/
theorem exh_subset_G {n : ℕ} : exh G n ⊆ G := by
  intro z hz
  by_contra hzG
  have h2 := hz.2 z hzG
  rw [sub_self, norm_zero] at h2
  have h3 : (0 : ℝ) < 1 / ((n : ℝ) + 2) := by positivity
  linarith

/-- The lecturer's "(ii) increasing": `Kₙ ⊆ Kₘ` for `n ≤ m` (lecture 15 p.1). -/
theorem exh_mono {n m : ℕ} (h : n ≤ m) : exh G n ⊆ exh G m := by
  intro z hz
  obtain ⟨hz1, hz2⟩ := hz
  have h1 : (n : ℝ) + 1 ≤ (m : ℝ) + 1 := by norm_cast; linarith
  have h2 : (1 : ℝ) / ((m : ℝ) + 2) ≤ 1 / ((n : ℝ) + 2) :=
    (one_div_le_one_div (by positivity) (by positivity)).mpr (by norm_cast; linarith)
  refine ⟨by linarith, ?_⟩
  intro v hv
  exact h2.trans (hz2 v hv)

/-- The lecturer's "(ii) strictly increasing": `Kₙ ⊆ interior Kₙ₊₁` (lecture 15 p.1-2); the proof is
the `δ := 1/n − 1/(n+1)` estimate. -/
theorem exh_subset_interior_succ (n : ℕ) : exh G n ⊆ interior (exh G (n + 1)) := by
  intro z hz
  have hc : (1 : ℝ) / ((n : ℝ) + 3) < 1 / ((n : ℝ) + 2) :=
    (one_div_lt_one_div (by positivity) (by positivity)).mpr (by
      have h : (0 : ℝ) ≤ n := Nat.cast_nonneg n
      linarith)
  set δ : ℝ := min 1 (1 / ((n : ℝ) + 2) - 1 / ((n : ℝ) + 3)) / 2 with hδ
  have δ0 : (0 : ℝ) < δ := by
    refine div_pos (lt_min (by positivity) (by linarith)) (by norm_num)
  have δ1 : δ ≤ 1 / ((n : ℝ) + 2) - 1 / ((n : ℝ) + 3) := by
    rw [hδ]
    have h2 : min 1 (1 / ((n : ℝ) + 2) - 1 / ((n : ℝ) + 3)) ≤
        1 / ((n : ℝ) + 2) - 1 / ((n : ℝ) + 3) := min_le_right _ _
    linarith
  refine mem_interior_iff_mem_nhds.mpr (Metric.mem_nhds_iff.mpr ⟨δ, δ0, ?_⟩)
  intro w hw
  rw [Metric.mem_ball, dist_eq_norm] at hw
  have h1 : ‖w‖ ≤ ‖z‖ + ‖w - z‖ := by
    calc ‖w‖ = ‖z + (w - z)‖ := by congr 1; abel
      _ ≤ ‖z‖ + ‖w - z‖ := norm_add_le _ _
  have hz1 : ‖z‖ ≤ (n : ℝ) + 1 := hz.1
  have h3 : ‖w - z‖ < 1 / 2 := by
    have h4 : δ ≤ 1 / 2 := by
      rw [hδ]
      have h5 : min 1 (1 / ((n : ℝ) + 2) - 1 / ((n : ℝ) + 3)) ≤ 1 := min_le_left _ _
      linarith
    linarith
  refine ⟨by
    have h4 : (((n + 1 : ℕ) : ℝ)) + 1 = (n : ℝ) + 2 := by
      simp only [Nat.cast_add, Nat.cast_one]
      ring
    have h5 : ‖w‖ < (n : ℝ) + 2 := by linarith
    rw [h4]
    linarith, fun v hv ↦ ?_⟩
  have h5 : (1 : ℝ) / ((n : ℝ) + 2) ≤ ‖z - v‖ := hz.2 v hv
  have h6 : ‖z - v‖ ≤ ‖z - w‖ + ‖w - v‖ := by
    calc ‖z - v‖ = ‖(z - w) + (w - v)‖ := by congr 1; abel
      _ ≤ ‖z - w‖ + ‖w - v‖ := norm_add_le _ _
  have h7 : ‖z - w‖ < δ := by rw [norm_sub_rev]; exact hw
  have h8 : (1 : ℝ) / (((n + 1 : ℕ) : ℝ) + 2) = 1 / ((n : ℝ) + 3) := by
    simp only [Nat.cast_add, Nat.cast_one]
    ring
  rw [h8]
  linarith

/-- The lecturer's "(i)": `G ⊆ ⋃ n, Kₙ` (lecture 15 p.1). -/
theorem subset_iUnion_exh (hG : IsOpen G) : G ⊆ ⋃ n, exh G n := by
  intro z hz
  obtain ⟨r, r0, hr⟩ : ∃ r : ℝ, 0 < r ∧ Metric.ball z r ⊆ G :=
    Metric.isOpen_iff.mp hG z hz
  obtain ⟨n, hn⟩ : ∃ n : ℕ, max (1 / r) ‖z‖ < (n : ℝ) := exists_nat_gt _
  refine Set.mem_iUnion_of_mem n ⟨?_, fun v hv ↦ ?_⟩
  · have h1 : ‖z‖ < (n : ℝ) := lt_of_le_of_lt (le_max_right _ _) hn
    linarith
  · have h1 : (1 / r : ℝ) < (n : ℝ) := lt_of_le_of_lt (le_max_left _ _) hn
    have h2 : (1 : ℝ) / ((n : ℝ) + 2) ≤ r :=
      ((one_div_lt (by positivity) r0).mpr (by linarith)).le
    have h3 : r ≤ ‖z - v‖ := by
      have h4 : ¬ (v ∈ Metric.ball z r) := fun h ↦ hv (hr h)
      rw [Metric.mem_ball, dist_eq_norm, not_lt] at h4
      rw [norm_sub_rev]
      exact h4
    by_contra h
    have h5 : ‖z - v‖ < r := lt_of_lt_of_le (lt_of_not_ge h) h2
    linarith

/-- The lecturer's "(i)": `G = ⋃ n, Kₙ` (lecture 15 p.1). -/
theorem iUnion_exh_eq_G (hG : IsOpen G) : ⋃ n, exh G n = G :=
  Set.Subset.antisymm (Set.iUnion_subset fun _ ↦ exh_subset_G) (subset_iUnion_exh hG)

/-- The covering step of the proof of the Compact Exhaustion Lemma (lecture 15 p.2): every compact
subset of `G` is contained in the interior of one of the `Kₙ`. -/
theorem exists_interior_exh_subset (hG : IsOpen G) {K : Set ℂ} (hK : IsCompact K) (hKG : K ⊆ G) :
    ∃ n : ℕ, K ⊆ interior (exh G n) := by
  obtain ⟨t, ht⟩ :=
    hK.elim_finite_subcover (fun i : ℕ ↦ interior (exh G (i + 1))) (fun _ ↦ isOpen_interior)
      (fun z hz ↦ by
        obtain ⟨n, hn⟩ := Set.mem_iUnion.mp (subset_iUnion_exh hG (hKG hz))
        exact Set.mem_iUnion.mpr ⟨n, exh_subset_interior_succ n hn⟩)
  refine ⟨∑ i ∈ t, (i + 1), fun z hz ↦ ?_⟩
  obtain ⟨i, hi⟩ := Set.mem_iUnion.mp (ht hz)
  obtain ⟨hit, hzi⟩ := Set.mem_iUnion.mp hi
  have h2 : i + 1 ≤ ∑ j ∈ t, (j + 1) :=
    Finset.single_le_sum (fun j _ ↦ Nat.zero_le (j + 1)) hit
  refine interior_mono (exh_mono h2) hzi

/-- `BoundedSet s` passes to subsets. -/
theorem BoundedSet.mono {s t : Set ℂ} (h : s ⊆ t) (ht : BoundedSet t) : BoundedSet s := by
  obtain ⟨R, hR⟩ := ht
  exact ⟨R, fun z hz ↦ hR z (h hz)⟩

/-! ## The components of `(exh G n)ᶜ` (lecture 15 p.2) -/

/-- The *collar* of `ℂ − G`: the union of the balls of radius `1 / ((n : ℝ) + 2)` centred at the
points of `ℂ − G`, i.e. the open set that the compact exhaustion `Conway.exh G n` cuts off around
`ℂ − G`.  The complement of `exh G n` is this collar together with the exterior of the disk of
radius `n + 1` (`Conway.exh_compl_subset`). -/
def collar (G : Set ℂ) (n : ℕ) : Set ℂ :=
  {z | ∃ v ∈ Gᶜ, ‖z - v‖ < (1 : ℝ) / ((n : ℝ) + 2)}

theorem mem_collar {G : Set ℂ} {n : ℕ} {z : ℂ} :
    z ∈ collar G n ↔ ∃ v ∈ Gᶜ, ‖z - v‖ < (1 : ℝ) / ((n : ℝ) + 2) := Iff.rfl

/-- `ℂ − G` lies in the collar: the balls are centred at its points. -/
theorem compl_G_subset_collar {n : ℕ} : Gᶜ ⊆ collar G n := by
  intro v hv
  exact ⟨v, hv, by rw [sub_self, norm_zero]; positivity⟩

/-- Each of the balls whose union is the collar lies in the collar. -/
theorem ball_subset_collar {n : ℕ} {v : ℂ} (hv : v ∈ Gᶜ) :
    Metric.ball v ((1 : ℝ) / ((n : ℝ) + 2)) ⊆ collar G n := by
  intro y hy
  rw [Metric.mem_ball, dist_eq_norm] at hy
  exact ⟨v, hv, hy⟩

/-- The collar is disjoint from `exh G n`: that is exactly the
`1 / ((n : ℝ) + 2) ≤ ‖z - v‖` condition of `Conway.WithinComplement`. -/
theorem collar_subset_exh_compl {n : ℕ} : collar G n ⊆ (exh G n)ᶜ := by
  intro z hz hW
  obtain ⟨v, hv, hz'⟩ := hz
  exact (not_le.mpr hz') (hW.2 v hv)

/-- The shape of the complement of `Kₙ` used in lecture 15 p.2: every point that is not in `Kₙ` is
either in the collar of `ℂ − G` (the "holes" cut off by `Kₙ`) or outside the disk `B̄(0; n+1)`. -/
theorem exh_compl_subset (n : ℕ) :
    (exh G n)ᶜ ⊆ {z : ℂ | (n : ℝ) + 1 < ‖z‖} ∪ collar G n := by
  intro z hz
  by_cases h1 : ‖z‖ ≤ (n : ℝ) + 1
  · refine Or.inr (by_contra fun hcon ↦ ?_)
    exact hz ⟨h1, fun v hv ↦ le_of_not_gt fun hlt ↦ hcon ⟨v, hv, hlt⟩⟩
  · exact Or.inl (not_le.mp h1)

/-- `‖(t : ℝ) • z‖ = |t| * ‖z‖` for a *real* scalar (used to identify an exterior of a disk with the
image of a cylinder). -/
theorem norm_smul_coe_one (t : ℝ) (z : ℂ) : ‖(t : ℝ) • z‖ = |t| * ‖z‖ := by
  rw [norm_smul, Real.norm_eq_abs]

/-- The real dimension of `ℂ` is bigger than one, so its spheres are connected. -/
theorem one_lt_rank_real_complex : (1 : Cardinal) < Module.rank ℝ ℂ := by
  rw [Complex.rank_real_complex]
  exact Nat.one_lt_ofNat

/-- The exterior of a disk is the image of the cylinder `(r, ∞) × ∂B(0;1)` under `(t, w) ↦ t • w`.
-/
theorem set_norm_gt_eq_smul_sphere (r : ℝ) :
    {z : ℂ | r < ‖z‖} = (fun p : ℝ × ℂ ↦ p.1 • p.2) '' (Set.Ioi r ×ˢ Metric.sphere (0 : ℂ) 1) := by
  refine Set.Subset.antisymm ?_ ?_
  · intro z hz
    by_cases hz0 : z = 0
    · subst hz0
      refine ⟨(0, 1), ⟨?_, ?_⟩, ?_⟩
      · simpa using hz
      · rw [Metric.mem_sphere, dist_eq_norm, sub_zero]
        norm_num
      · exact zero_smul ℝ (1 : ℂ)
    · refine ⟨(‖z‖, (‖z‖ : ℝ)⁻¹ • z), ⟨hz, ?_⟩, ?_⟩
      · rw [Metric.mem_sphere, dist_eq_norm, sub_zero, norm_smul_coe_one, abs_inv,
          abs_of_nonneg (norm_nonneg _)]
        exact inv_mul_cancel₀ (norm_ne_zero_iff.mpr hz0)
      · change (‖z‖ : ℝ) • ((‖z‖ : ℝ)⁻¹ • z) = z
        rw [smul_smul, mul_inv_cancel₀ (norm_ne_zero_iff.mpr hz0), one_smul]
  · rintro z ⟨p, ⟨hp, hp2⟩, rfl⟩
    rw [Set.mem_Ioi] at hp
    have h2 : ‖(p.2 : ℂ)‖ = 1 := by
      rw [Metric.mem_sphere] at hp2
      rw [← hp2, dist_eq_norm, sub_zero]
    change r < ‖(p.1 : ℝ) • (p.2 : ℂ)‖
    rw [norm_smul_coe_one, h2, mul_one]
    exact lt_of_lt_of_le hp (le_abs_self _)

/-- The "component through `∞`" of lecture 15 p.2 is connected: the exterior of a disk is the
continuous image of the connected cylinder `(r, ∞) × ∂B(0;1)`. -/
theorem isConnected_set_norm_gt (r : ℝ) : IsConnected {z : ℂ | r < ‖z‖} := by
  rw [set_norm_gt_eq_smul_sphere]
  refine IsConnected.image ?_ (fun p : ℝ × ℂ ↦ p.1 • p.2) ?_
  · exact isConnected_Ioi.prod (isConnected_sphere one_lt_rank_real_complex (0 : ℂ) (by norm_num))
  · exact Continuous.continuousOn (by continuity)

/-- … and it is not bounded: this is the component that Runge's theorem needs `∞` for. -/
theorem not_boundedSet_set_norm_gt (r : ℝ) : ¬BoundedSet {z : ℂ | r < ‖z‖} := by
  intro h
  obtain ⟨R, hR⟩ := h
  have h1 : (0 : ℝ) < max (max R r) 0 + 1 := by
    have h5 : (0 : ℝ) ≤ max (max R r) 0 := le_max_right _ _
    linarith
  have h2 : ‖(max (max R r) 0 + 1 : ℝ) • (1 : ℂ)‖ = max (max R r) 0 + 1 := by
    rw [norm_smul_coe_one, norm_one, mul_one, abs_of_nonneg (le_of_lt h1)]
  have h3 : (max (max R r) 0 + 1 : ℝ) • (1 : ℂ) ∈ {z : ℂ | r < ‖z‖} := by
    change r < ‖(max (max R r) 0 + 1 : ℝ) • (1 : ℂ)‖
    rw [h2]
    have h5 : r ≤ max R r := le_max_right _ _
    have h6 : max R r ≤ max (max R r) 0 := le_max_left _ _
    linarith
  have h4 : ‖(max (max R r) 0 + 1 : ℝ) • (1 : ℂ)‖ < R := hR _ h3
  rw [h2] at h4
  have h5 : R ≤ max R r := le_max_left _ _
  have h6 : max R r ≤ max (max R r) 0 := le_max_left _ _
  linarith

/-- **The component condition passes to the exhaustion** (lecture 15 p.2): if the allowed pole set
`E ∪ {∞ if atInfinity}` meets every component of `ℂ∞ − G`, then it meets every component of
`ℂ∞ − Kₙ`.

The lecturer's proof: let `w ∉ Kₙ`.  If the component of `(exh G n)ᶜ` through `w` meets the
collar of `ℂ − G`, it contains the ball of radius `1/n` about some `v ∉ G` — that ball is
connected, meets the component, and lies in `(exh G n)ᶜ` — hence it contains the whole component of
`ℂ − G` through `v`, which holds an allowed pole.  If it does not meet the collar, it contains the
exterior `{z : (n+1) < ‖z‖}` (by `Conway.exh_compl_subset`) and is therefore unbounded: this is the
component through `∞`, and the hypothesis `atInfinity = true ∨ ¬BoundedSet Gᶜ` says precisely that
it holds the pole `∞`.  (That hypothesis is part of the lecturer's statement: with `∞ ∉ E`, "every
component of `ℂ∞ − G` meets `E`" already forces `ℂ − G` to be unbounded, since otherwise the
component through `∞` would be a bounded component missed by `E`.) -/
theorem meetsComponents_exh {n : ℕ} (hinf : atInfinity = true ∨ ¬BoundedSet Gᶜ)
    (h : MeetsComponents G E atInfinity) : MeetsComponents (exh G n) E atInfinity := by
  intro w hw
  by_cases hv : (connectedComponentIn (exh G n)ᶜ w ∩ collar G n).Nonempty
  · -- a hole of `Kₙ`: the collar ball through it is connected, so it lies in this one component
    obtain ⟨y, hy1, hy2⟩ := hv
    obtain ⟨v, hvG, hyv⟩ := hy2
    have hr : (0 : ℝ) < 1 / ((n : ℝ) + 2) := by positivity
    have h0 : y ∈ Metric.ball v ((1 : ℝ) / ((n : ℝ) + 2)) :=
      Metric.mem_ball.mpr (by rw [dist_eq_norm]; exact hyv)
    have h1 : Metric.ball v ((1 : ℝ) / ((n : ℝ) + 2)) ⊆ connectedComponentIn (exh G n)ᶜ y :=
      (isConnected_ball hr).isPreconnected.subset_connectedComponentIn h0
        ((ball_subset_collar hvG).trans collar_subset_exh_compl)
    have h2 : connectedComponentIn (exh G n)ᶜ y = connectedComponentIn (exh G n)ᶜ w :=
      Eq.symm (connectedComponentIn_eq hy1)
    have h3 : v ∈ connectedComponentIn (exh G n)ᶜ w := by
      rw [← h2]
      exact h1 (Metric.mem_ball.mpr (by rw [dist_self]; exact hr))
    have h4 : connectedComponentIn Gᶜ v ⊆ connectedComponentIn (exh G n)ᶜ v :=
      (isConnected_connectedComponentIn_iff.mpr hvG).isPreconnected.subset_connectedComponentIn
        (mem_connectedComponentIn hvG)
        ((connectedComponentIn_subset Gᶜ v).trans (Set.compl_subset_compl.mpr exh_subset_G))
    have h5 : connectedComponentIn Gᶜ v ⊆ connectedComponentIn (exh G n)ᶜ w := by
      intro z hz
      rw [connectedComponentIn_eq h3]
      exact h4 hz
    cases h v hvG with
    | inl h6 =>
      obtain ⟨z, hz1, hz2⟩ := h6
      exact .inl ⟨_, h5 hz1, hz2⟩
    | inr h6 => exact .inr ⟨h6.1, fun hB ↦ h6.2 (hB.mono h5)⟩
  · -- the component through `∞`: it contains the whole exterior of `B̄(0; n+1)`
    have h2 : {z : ℂ | (n : ℝ) + 1 < ‖z‖} ⊆ connectedComponentIn (exh G n)ᶜ w := by
      have hw' : w ∈ {z : ℂ | (n : ℝ) + 1 < ‖z‖} := by
        cases exh_compl_subset n hw with
        | inl hz => exact hz
        | inr hz =>
          exact absurd (Set.nonempty_of_mem (Set.mem_inter (mem_connectedComponentIn hw) hz)) hv
      refine (isConnected_set_norm_gt _).isPreconnected.subset_connectedComponentIn hw' ?_
      intro z hz hWz
      exact lt_irrefl _ (lt_of_lt_of_le hz hWz.1)
    cases hinf with
    | inl hAt => exact .inr ⟨hAt, fun hB ↦ not_boundedSet_set_norm_gt _ (hB.mono h2)⟩
    | inr hnb =>
      exfalso
      refine hnb ⟨(n : ℝ) + 2, fun v hv' ↦ ?_⟩
      have h3 : v ∈ collar G n := compl_G_subset_collar hv'
      have h4 : ¬((n : ℝ) + 1 < ‖v‖) := fun hlt ↦ hv ⟨v, h2 hlt, h3⟩
      linarith

/-! ## Runge's theorem on an open set (lecture 14 p.4) -/

/-- **Runge's theorem on an open set** (lecture 14 p.4, Conway VIII.1.14): if `G ⊆ ℂ` is open and
the pole set `E ∪ {∞ if atInfinity}` meets every component of `ℂ∞ − G`, then every function `f`
holomorphic on `G` is the limit, uniformly on compact subsets of `G`, of a sequence of rational
functions whose poles lie only in `E ∪ {∞ if atInfinity}`.

The proof is the lecturer's: apply Runge's theorem for compact sets (`Conway.runge`) to each member
`Conway.exh G n` of the compact exhaustion of lecture 15 p.2, with `ε := 1/(n+2)`, and paste the
approximations together; `Conway.exists_ratFun_of_mem_RatAlgOn` turns each approximation, which
lives on `exh G n`, into a rational function on all of `ℂ`.

The hypothesis `Conway.MeetsComponents G E atInfinity` is the form of "the pole set meets every
component of `ℂ∞ − G`" that is used for `Conway.runge`; it is what the compact exhaustion needs
(`Conway.meetsComponents_exh`), and it is what the lecturer verifies in the two cases he spells out
(`G = ℂ`, and `G` with connected complement).  It says: every component of `ℂ − G` that does not
contain `∞`, i.e. every *bounded* component, contains a point of `E` unless `∞` itself is an allowed
pole.

The extra hypothesis `hinf` says that the component of `ℂ∞ − G` through `∞` really does hold the
pole `∞`: either `∞` is an allowed pole (`atInfinity = true`) or `ℂ − G` is unbounded, which is
forced in the lecture's reading of "E meets every component of `ℂ∞ − G`" when `∞ ∉ E`. -/
theorem runge_open (hG : IsOpen G) (hEG : ∀ a ∈ E, a ∉ G)
    (hinf : atInfinity = true ∨ ¬BoundedSet Gᶜ)
    (hE : MeetsComponents G E atInfinity) (f : ℂ → ℂ) (hf : DifferentiableOn ℂ f G) :
    ∃ R : ℕ → (ℂ → ℂ), (∀ n, R n ∈ RatFun E atInfinity) ∧
      ∀ Ks, IsCompact Ks → Ks ⊆ G → TendstoUniformOn Ks (fun n z ↦ R n z) fun z ↦ f z := by
  have h1 : ∀ n : ℕ, ∃ g : ℂ → ℂ, g ∈ RatFun E atInfinity ∧
      ∀ z : ↥(exh G n), ‖g z - f z‖ < 1 / ((n : ℝ) + 2) := by
    intro n
    obtain ⟨x, hx, hx'⟩ :=
      runge (isCompact_exh n) isOpen_interior (exh_subset_interior_succ n)
        (fun a ha hxa ↦ hEG a ha (exh_subset_G hxa)) (meetsComponents_exh (n := n) hinf hE) f
        (hf.mono (interior_subset.trans exh_subset_G)) (1 / ((n : ℝ) + 2)) (by positivity)
    obtain ⟨g, hg, hgz⟩ := exists_ratFun_of_mem_RatAlgOn hx
    refine ⟨g, hg, fun z ↦ ?_⟩
    have h2 : ‖g z - f z‖ = ‖(fun z : ↥(exh G n) ↦ f z) z - x z‖ := by
      rw [norm_sub_rev, hgz z]
    rw [h2]
    exact hx' z
  choose R hRmem hRapp using h1
  refine ⟨R, hRmem, fun Ks hKs hKGs ↦ ?_⟩
  intro ε ε0
  obtain ⟨m, hm⟩ := exists_interior_exh_subset hG hKs hKGs
  obtain ⟨N, hN⟩ := exists_nat_one_div_lt ε ε0
  refine ⟨max m N, fun n hn z ↦ lt_of_lt_of_le (hRapp n ⟨(z : ℂ),
    exh_mono (le_trans (Nat.le_max_left m N) hn) (interior_subset (hm z.2))⟩)
    (le_of_lt (hN n (Nat.max_le.mp hn).2))⟩

/-- **Runge's theorem on an open set, polynomials** (lecture 14 p.4, Conway VIII.1.15): if `G ⊆ ℂ`
is open and has *no bounded complementary component* — which is the content, in `ℂ`, of the
lecturer's "suppose `ℂ∞ − G` is connected" — then every function holomorphic on `G` is the limit,
uniformly on compact subsets of `G`, of a sequence of polynomial functions
(`Conway.PolyFun`, the "take `E = {∞}`" of the notes). -/
theorem runge_open_polys (hG : IsOpen G)
    (h : ∀ w ∈ Gᶜ, ¬BoundedSet (connectedComponentIn Gᶜ w)) (f : ℂ → ℂ)
    (hf : DifferentiableOn ℂ f G) :
    ∃ R : ℕ → (ℂ → ℂ), (∀ n, R n ∈ PolyFun) ∧
      ∀ Ks, IsCompact Ks → Ks ⊆ G → TendstoUniformOn Ks (fun n z ↦ R n z) fun z ↦ f z := by
  obtain ⟨R, hR, hconv⟩ :=
    runge_open (E := (∅ : Set ℂ)) (atInfinity := true) hG
      (fun a ha ↦ absurd ha (by simp)) (Or.inl rfl)
      (fun w hw ↦ Or.inr ⟨by simp, h w hw⟩) f hf
  refine ⟨R, ?_, hconv⟩
  intro n
  rw [← RatFun.empty_true]
  exact hR n

end
