module

public import Conway.Separation
public import Conway.PolePushing

/-!
# MA5217 / Conway Chapter VIII, §1: Runge's theorem (Conway VIII.1.7)

This file contains Runge's theorem for compact subsets of open sets (lecture 14 p.2-4, Conway
VIII.1.7): if `K ⊆ G ⊆ ℂ` with `K` compact and `G` open, and if the pole set
`E ∪ {∞ if atInfinity}` is contained in `ℂ∞ − K` and meets every component of `ℂ∞ − K`, then
every function holomorphic on `G` is the uniform limit on `K` of rational functions whose poles
lie only in `E ∪ {∞ if atInfinity}` (`Conway.runge`, with the `ε`-form of the lecturer in
`Conway.runge'`).

The formalization follows the lecturer's proof line by line (lecture 14 p.2-4):

1. *Weak Runge's theorem* (the case `E = ℂ∞ − K`, `Conway.weakRunge`) together with *Lemma 1*
   (`Conway.Approximable.trans`): "by weak Runge's theorem and Lemma 1 we may assume the
   holomorphic function `f` is a rational function whose poles lie in `ℂ∞ − K`" — in the form of
   `Conway.Approximable.trans` applied to `Conway.weakRunge`;
2. *Partial fractions* and *Lemma 0*: "we may assume further that `f` has only one pole `z₀`".
   `Conway.RatAlg` is *defined* as the algebra generated by the single-pole functions
   `z ↦ (z - a)⁻¹`, `a ∈ E`, so the reduction to one pole is `Algebra.adjoin_le`, and Lemma 0 is
   `Conway.Approximable.mul` (its boundedness hypothesis is `Conway.RatAlgOn.le_boundedAlg`);
3. for a single pole `z₀ ∈ ℂ∞ − K` the point `w ∈ E` of the component `U` of `z₀` is reached by a
   polygonal path `γ` in `U`, and `Conway.PoleChain.approximable` is exactly the induction along the
   segments of `γ` ("this is proved by induction on `n` using the pole pushing lemma"), the case
   `w = ∞` being the Taylor expansion (`Conway.poleChain_none_of_unbounded`);
4. `Conway.approximable_polys` is the `E = {∞}` case (Conway VIII.1.9), i.e. the "hence" of the
   lecturer's Corollary 1.15.

## Inputs from outside the notes

`Conway.exists_poleChain_of_sameComponent` (components of `Kᶜ` are polygonally connected, i.e.
invariance of domain) and `Conway.enhancedSeparationLemma` (winding numbers of 1-cycles) are the
only axioms.
-/

@[expose] public section


open Set Filter TopologicalSpace Metric
open scoped BigOperators

namespace Conway

noncomputable section

variable {K G E : Set ℂ} {atInfinity : Bool}

/-! ## The finite generators `z ↦ (z - z₀)⁻¹`, `z₀ ∈ ℂ∞ − K`, are approximable -/

/-- The allowed pole algebra `RatAlgOn E atInfinity K = ℂ_{E ∪ {∞ if atInfinity}}(z)|K` consists of
bounded functions on the compact set `K`, provided none of the poles lies on `K`. -/
theorem RatAlgOn.le_boundedAlg (hK : IsCompact K) (hE : ∀ a ∈ E, a ∉ K) :
    RatAlgOn E atInfinity K ≤ BoundedAlg K := by
  cases atInfinity with
  | false => rw [RatAlgOn_eq_false]; exact RatAlg.le_boundedAlg hK hE
  | true => rw [RatAlgOn_eq_true]; exact RatAlgInf.le_boundedAlg hK hE

/-- **The pole pushing step of Runge's theorem** (lecture 14 p.3): if the pole set `E ∪ {∞ if
atInfinity}` meets every component of `ℂ∞ − K`, then for every `z₀ ∈ ℂ∞ − K` the generator
`z ↦ (z - z₀)⁻¹` is the uniform limit on `K` of rational functions whose only pole is in `E`:
push the pole to a point `w ∈ E` of the component of `z₀` (the finite `w` case of the lecturer), or,
when `∞` is an allowed pole and the component of `z₀` is the unbounded one, push it out to `∞`. -/
theorem approximable_invSub_of_meetsComponents (hK : IsCompact K)
    (hE : MeetsComponents K E atInfinity) {z₀ : ℂ} (hz₀ : z₀ ∉ K) :
    Approximable (RatAlgOn E atInfinity K) (invSub z₀ K) := by
  cases atInfinity with
  | false =>
      rw [RatAlgOn_eq_false]
      obtain ⟨w, hwc, hw⟩ :=
        (hE z₀ hz₀).elim (fun h ↦ h) (fun h ↦ absurd h.1 (by simp))
      refine Approximable.mono (PoleAt.le hw) ?_
      have hwK : w ∉ K := by simpa using connectedComponentIn_subset Kᶜ z₀ hwc
      have hc := exists_poleChain_of_sameComponent hK hz₀ hwK (connectedComponentIn_eq hwc)
      exact hc.approximable hK
  | true =>
      rw [RatAlgOn_eq_true]
      cases hE z₀ hz₀ with
      | inl h =>
          obtain ⟨w, hwc, hw⟩ := h
          have hwK : w ∉ K := by simpa using connectedComponentIn_subset Kᶜ z₀ hwc
          refine Approximable.mono ((PoleAt.le hw).trans RatAlg.le_RatAlgInf) ?_
          exact (exists_poleChain_of_sameComponent hK hz₀ hwK
            (connectedComponentIn_eq hwc)).approximable hK
      | inr h =>
          have hc : PoleChain K z₀ none := poleChain_none_of_unbounded hK hz₀ h.2
          have h1 : Approximable (Target K none) (invSub z₀ K) := hc.approximable hK
          rw [target_none] at h1
          exact h1.mono Polys.le_RatAlgInf

/-- **Runge's theorem for compact subsets of open sets** (lecture 14 p.2-3, Conway VIII.1.7): the
holomorphic function `f` on the neighbourhood `G` of the compact set `K` is the uniform limit on
`K` of rational functions whose poles lie only in `E ∪ {∞ if atInfinity}`, provided that set meets
every component of `ℂ∞ − K`.

This is the lecturer's proof: the *weak Runge theorem* (the case `E = ℂ∞ − K`, i.e.
`Conway.weakRunge`) reduces the claim to the generators `z ↦ (z - z₀)⁻¹`, `z₀ ∈ ℂ∞ − K`
("by weak Runge's theorem and Lemma 1 we may assume `f` is a rational function whose poles lie in
`ℂ∞ − K`"); the *partial fractions* presentation `RatAlg` of the rational functions with poles in
`E`, together with *Lemma 0* (`Approximable.mul`), reduces it further to a single pole
("by partial fractions expansion and Lemma 0 we may assume further that `f` has only one pole
`z₀`"); *`Conway.PoleChain.approximable`* is the pole pushing lemma along the polygonal path `γ`,
and *Lemma 1* (`Approximable.trans`) puts the approximations together. -/
theorem runge (hK : IsCompact K) (hG : IsOpen G) (hKG : K ⊆ G) (hEK : ∀ a ∈ E, a ∉ K)
    (hE : MeetsComponents K E atInfinity) (f : ℂ → ℂ) (hf : DifferentiableOn ℂ f G) :
    Approximable (RatAlgOn E atInfinity K) fun z : ↥K ↦ f z := by
  have hB : RatAlgOn E atInfinity K ≤ BoundedAlg K := RatAlgOn.le_boundedAlg hK hEK
  have hsub : RatAlg Kᶜ K ≤ approximableSubalgebra (RatAlgOn E atInfinity K) hB :=
    Algebra.adjoin_le (Set.image_subset_iff.mpr fun a ha ↦
      approximable_invSub_of_meetsComponents hK hE ha)
  refine Approximable.trans (C := RatAlg Kᶜ K) ?_ (weakRunge hK hG hKG f hf)
  exact fun g hg ↦ hsub hg

/-- **Runge's theorem in the `ε`-form of lecture 14 p.2**: there is a rational function whose poles
lie only in `E ∪ {∞ if atInfinity}` and which is within `ε` of `f` at every point of `K`. -/
theorem runge' (hK : IsCompact K) (hG : IsOpen G) (hKG : K ⊆ G) (hEK : ∀ a ∈ E, a ∉ K)
    (hE : MeetsComponents K E atInfinity) (f : ℂ → ℂ) (hf : DifferentiableOn ℂ f G)
    (ε : ℝ) (ε0 : 0 < ε) :
    ∃ R ∈ RatAlgOn E atInfinity K, Within K ε (fun z : ↥K ↦ f z) R :=
  runge hK hG hKG hEK hE f hf ε ε0

/-- The version with `∞` among the allowed poles (the `atInfinity = true` case). -/
theorem rungeInf (hK : IsCompact K) (hG : IsOpen G) (hKG : K ⊆ G) (hEK : ∀ a ∈ E, a ∉ K)
    (hE : MeetsComponents K E true) (f : ℂ → ℂ) (hf : DifferentiableOn ℂ f G) :
    Approximable (RatAlgInf E K) fun z : ↥K ↦ f z := runge hK hG hKG hEK hE f hf

/-- `∅ ∪ {∞}` is a valid pole set for `ℂ∞ − K` when that set is connected, i.e. when every
component of `ℂ − K` is unbounded: this is the hypothesis of Conway VIII.1.9 and of the lecturer's
"take `E = {∞}`" in Corollary 1.15. -/
theorem RatAlgInf.empty : RatAlgInf (∅ : Set ℂ) K ≤ Polys K := by
  change Algebra.adjoin ℂ (Set.image (fun a : ℂ ↦ invSub a K) ∅ ∪ {coord K} :
      Set (↥K → ℂ)) ≤ Polys K
  rw [Set.image_empty, Set.empty_union]
  exact Algebra.adjoin_le (Set.singleton_subset_iff.mpr Polys.mem_of_mem)

/-- **Approximation by polynomials** (Conway VIII.1.9, the `E = {∞}` case of Runge's theorem, the
"hence" of the lecturer's Corollary 1.15 on lecture 15 p.4): if `ℂ∞ − K` is connected — i.e. `K` has
no bounded complementary component — then every function holomorphic on a neighbourhood of `K` is
the uniform limit on `K` of polynomials. -/
theorem approximable_polys (hK : IsCompact K) (hG : IsOpen G) (hKG : K ⊆ G)
    (h : ∀ w ∈ Kᶜ, ¬BoundedSet (connectedComponentIn Kᶜ w))
    (f : ℂ → ℂ) (hf : DifferentiableOn ℂ f G) :
    Approximable (Polys K) fun z : ↥K ↦ f z := by
  have hE : MeetsComponents K (∅ : Set ℂ) true := fun w hw ↦ Or.inr ⟨by simp, h w hw⟩
  have hEK : ∀ a ∈ (∅ : Set ℂ), a ∉ K := fun a ha ↦ absurd ha (by simp)
  exact ((runge hK hG hKG hEK hE f hf)).mono RatAlgInf.empty

end

end Conway
