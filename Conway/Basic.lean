/-!
# MA5217 / Conway *Functions of One Complex Variable I*, Chapter VIII

This file fixes the vocabulary used throughout the formalization of Chapter VIII (Runge's
theorem, simple connectedness, Mittag-Leffler's theorem) as it was lectured in MA5217
lectures 13-17.

The lecturer works on the Riemann sphere `ℂ∞ = ℂ ∪ {∞}`.  Following the way the lecturer handles
`∞` himself ("if `w = ∞`, then choose `a ∈ ℂ` and `R > 0` such that `K ⊆ B(a;R)` and
`z₀ ∉ B(a;R)`"), we work in `ℂ` and record the possibility of a pole at `∞` — equivalently, the
presence of a polynomial part — by adjoining the coordinate function `z ↦ z` to the algebra, see
`RatAlgInf` and `Polys`.

`RatAlg E K` is the algebra of rational functions on `K` with poles in `E ⊆ ℂ` and no pole at
`∞`; `RatAlgInf E K` additionally allows a polynomial part (a pole at `∞`).

`Approximable A f` says that `f` can be uniformly approximated on `K` by members of `A`.  With
`A = RatAlg E K` this is the set `B(E)` of Conway VIII.1.8.

`TendstoUniformOn K F f` is uniform convergence of the sequence `F` to `f` on `K`; the two
lemmas `TendstoUniformOn.add` (Lemma 0) and `exists_tendstoUniformOn_diag` (Lemma 1) are the two
results stated as "Lemma 0" and "Lemma 1" on p.2 of lecture 14.
-/

@[expose] public section

open Set Filter TopologicalSpace Metric

namespace Conway

noncomputable section

variable {K E : Set ℂ} {A B : Subalgebra ℂ (↥K → ℂ)}

/-! ## The algebras of rational functions -/

/-- The generator `z ↦ (z - a)⁻¹` of the algebra of rational functions with a pole at `a`. -/
def invSub (a : ℂ) (K : Set ℂ) : ↥K → ℂ := fun z ↦ (z - a)⁻¹

/-- The coordinate function on `K`; adjoining it is what adds a pole at `∞`. -/
def coord (K : Set ℂ) : ↥K → ℂ := Subtype.val

/-- `RatAlg E K` is the ℂ-subalgebra of `K → ℂ` generated by the functions `z ↦ (z - a)⁻¹`,
`a ∈ E`: the restrictions to `K` of the rational functions all of whose poles lie in `E` and which
have no pole at `∞`. -/
def RatAlg (E K : Set ℂ) : Subalgebra ℂ (↥K → ℂ) :=
  Algebra.adjoin ℂ (Set.image (fun a ↦ invSub a K) E)

/-- `RatAlgInf E K` is `RatAlg E K` with the coordinate function adjoined: the rational functions
whose poles lie in `E ∪ {∞}`, i.e. those with a polynomial part allowed. -/
def RatAlgInf (E K : Set ℂ) : Subalgebra ℂ (↥K → ℂ) :=
  Algebra.adjoin ℂ (Set.image (fun a ↦ invSub a K) E ∪ {coord K})

/-- `Polys K`: the polynomial functions on `K`; this is the algebra of rational functions whose
only pole is `∞`.  The lecturer's "take `E = {∞}`" (Conway VIII.1.15) is approximation by elements
of `Polys K`. -/
def Polys (K : Set ℂ) : Subalgebra ℂ (↥K → ℂ) :=
  Algebra.adjoin ℂ {coord K}

/-- `PoleAt q K`: the rational functions on `K` whose only pole is the finite point `q`, i.e.
polynomials in `(z - q)⁻¹`.  These are the partial sums of a Laurent series as in lecture 13 p.4:
`R(z) = ∑ n in Finset.Icc 1 N, aₙ (z - z₀) ^ (-(n : ℤ))`. -/
def PoleAt (q : ℂ) (K : Set ℂ) : Subalgebra ℂ (↥K → ℂ) :=
  Algebra.adjoin ℂ {invSub q K}

/-- The algebra of rational functions whose poles lie in `E ⊆ ℂ`, together with a polynomial part
when `atInfinity = true`: the rational functions whose poles lie in `E ∪ {∞} ⊆ ℂ∞`. -/
def RatAlgOn (E : Set ℂ) (atInfinity : Bool) (K : Set ℂ) : Subalgebra ℂ (↥K → ℂ) :=
  if atInfinity then RatAlgInf E K else RatAlg E K

theorem RatAlgOn_eq_true : RatAlgOn E true K = RatAlgInf E K := by simp [RatAlgOn]
theorem RatAlgOn_eq_false : RatAlgOn E false K = RatAlg E K := by simp [RatAlgOn]

theorem RatAlg.mem_of_mem {a : ℂ} (ha : a ∈ E) : invSub a K ∈ RatAlg E K :=
  Algebra.subset_adjoin (Set.mem_image_of_mem _ ha)

theorem RatAlg.mono {F : Set ℂ} (h : E ⊆ F) : RatAlg E K ≤ RatAlg F K :=
  Algebra.adjoin_mono (Set.image_mono h)

theorem RatAlgInf.mem_of_mem {a : ℂ} (ha : a ∈ E) : invSub a K ∈ RatAlgInf E K :=
  Algebra.subset_adjoin (Set.mem_union_left _ (Set.mem_image_of_mem _ ha))

theorem RatAlgInf.coord_mem : coord K ∈ RatAlgInf E K :=
  Algebra.subset_adjoin (Set.mem_union_right _ rfl)

theorem RatAlgInf.mono {F : Set ℂ} (h : E ⊆ F) : RatAlgInf E K ≤ RatAlgInf F K :=
  Algebra.adjoin_mono (Set.union_subset_union_left _ (Set.image_mono h))

theorem PoleAt.mem_of_mem (q : ℂ) : invSub q K ∈ PoleAt q K := Algebra.subset_adjoin rfl

theorem PoleAt.le {q : ℂ} (hq : q ∈ E) : PoleAt q K ≤ RatAlg E K :=
  Algebra.adjoin_mono (Set.singleton_subset_iff.mpr (Set.mem_image_of_mem _ hq))

theorem RatAlg.le_RatAlgInf : RatAlg E K ≤ RatAlgInf E K :=
  Algebra.adjoin_mono Set.subset_union_left

theorem Polys.le_RatAlgInf : Polys K ≤ RatAlgInf E K :=
  Algebra.adjoin_mono (Set.singleton_subset_iff.mpr (Set.mem_union_right _ rfl))

theorem Polys.mem_of_mem : coord K ∈ Polys K := Algebra.subset_adjoin rfl

/-- A sum in a function algebra, evaluated pointwise: this is `Finset.sum_apply` in the direction
that turns the pointwise sum `fun z ↦ ∑ k ∈ s, f k z` into a sum of functions. -/
theorem pi_sum_apply {ι α β : Type*} [AddCommMonoid β] (s : Finset ι) (f : ι → α → β) :
    (∑ i ∈ s, f i) = fun a ↦ ∑ i ∈ s, f i a := by
  ext a
  exact Finset.sum_apply a s f

/-- A partial sum of a Laurent series in the generator `z ↦ (z - q)⁻¹` — the rational function
`R` of lecture 13 p.4, and the approximants produced by the Cauchy transform of a segment — lies in
the algebra `PoleAt q K` of functions whose only pole is `q`. -/
theorem mem_PoleAt_sum {ι : Type*} (s : Finset ι) (c : ι → ℂ) (e : ι → ℕ) (q : ℂ) :
    (fun z : ↥K ↦ ∑ k ∈ s, c k * invSub q K z ^ (e k)) ∈ PoleAt q K := by
  have h2 : (fun z : ↥K ↦ ∑ k ∈ s, c k * invSub q K z ^ (e k)) =
      ∑ k ∈ s, (fun z : ↥K ↦ c k * invSub q K z ^ (e k)) :=
    (pi_sum_apply s (fun k z ↦ c k * invSub q K z ^ (e k))).symm
  rw [h2]
  apply Subalgebra.sum_mem
  intro k _
  have h1 : (fun z : ↥K ↦ c k * invSub q K z ^ (e k)) =
      (algebraMap ℂ (↥K → ℂ) (c k)) * (invSub q K ^ e k) := by
    ext z
    simp [invSub]
  rw [h1]
  have ha : algebraMap ℂ (↥K → ℂ) (c k) ∈ PoleAt q K := Subalgebra.algebraMap_mem _ _
  have hb : invSub q K ^ e k ∈ PoleAt q K := Subalgebra.pow_mem _ (PoleAt.mem_of_mem q) _
  exact Subalgebra.mul_mem (PoleAt q K) ha hb

/-! ## Approximation -/

/-- `Within K ε f g`: `f` and `g` are within `ε` of each other at every point of `K`; this is the
display `|f(z) - R(z)| < ε` for all `z ∈ K` of the lecturer's statements. -/
abbrev Within (K : Set ℂ) (ε : ℝ) (f g : ↥K → ℂ) : Prop := ∀ z : ↥K, ‖f z - g z‖ < ε

/-- `Approximable A f`: the function `f : K → ℂ` can be uniformly approximated on `K` by members
of the algebra `A`.  In the notation of the notes, with `A = RatAlg E K`, `f` belongs to the set
`B(E)` of rational functions with poles in `E` (Conway VIII.1.8). -/
def Approximable (A : Subalgebra ℂ (↥K → ℂ)) (f : ↥K → ℂ) : Prop :=
  ∀ ε > (0 : ℝ), ∃ g ∈ A, Within K ε f g

theorem approximable_of_mem (g : ↥K → ℂ) (hg : g ∈ A) : Approximable A g := fun ε ε0 ↦
  ⟨g, hg, fun z ↦ by simpa using ε0⟩

theorem Approximable.mono (h : A ≤ B) (hf : Approximable A f) : Approximable B f :=
  fun ε ε0 ↦ let ⟨g, hg, hz⟩ := hf ε ε0; ⟨g, h hg, hz⟩

theorem Approximable.congr {f g : ↥K → ℂ} (h : f = g) (hf : Approximable A f) :
    Approximable A g := h ▸ hf

theorem Approximable.zero (A : Subalgebra ℂ (↥K → ℂ)) : Approximable A 0 :=
  approximable_of_mem _ (Subalgebra.zero_mem A)

theorem Approximable.one (A : Subalgebra ℂ (↥K → ℂ)) : Approximable A 1 :=
  approximable_of_mem _ (Subalgebra.one_mem A)

theorem approximable_const (A : Subalgebra ℂ (↥K → ℂ)) (c : ℂ) : Approximable A fun _z ↦ c := by
  have := approximable_of_mem _ (Subalgebra.algebraMap_mem A c)
  convert this using 1
  ext z
  simp

/-- **Lemma 0** of the notes (lecture 14 p.2).  The lecturer states Lemma 0 as the elementary fact
that `{fₙ + gₙ} → f + g` uniformly when `{fₙ} → f` and `{gₙ} → g` uniformly; its use in the proofs
of Runge's and Mittag-Leffler's theorems is the following consequence: a sum of approximable
functions is approximable. -/
theorem Approximable.add (hf : Approximable A f) (hg : Approximable A g) :
    Approximable A fun z ↦ f z + g z := by
  intro ε ε0
  obtain ⟨u, hu, hu'⟩ := hf (ε / 2) (by positivity)
  obtain ⟨v, hv, hv'⟩ := hg (ε / 2) (by positivity)
  refine ⟨fun z ↦ u z + v z, A.add_mem hu hv, fun z ↦ ?_
  ⟩
  have h1 : ‖f z + g z - (u z + v z)‖ ≤ ‖f z - u z‖ + ‖g z - v z‖ := by
    rw [show f z + g z - (u z + v z) = (f z - u z) + (g z - v z) by abel]
    exact norm_add_le _ _
  linarith [h1, hu' z, hv' z]

/-- Scalar multiples of approximable functions are approximable. -/
theorem Approximable.const_smul (c : ℂ) (hf : Approximable A f) :
    Approximable A fun z ↦ c * f z := by
  by_cases hc : c = 0
  · subst hc
    convert Approximable.zero A using 1
    ext z
    simp
  · intro ε ε0
    obtain ⟨u, hu, hu'⟩ := hf (ε / ‖(c : ℂ)‖) (div_pos ε0 (norm_pos_iff.mpr hc))
    refine ⟨c • u, A.smul_mem hu _, fun z ↦ ?_
    ⟩
    simp only [Pi.smul_apply, smul_eq_mul]
    rw [← mul_sub, Complex.norm_mul]
    exact (mul_lt_mul_of_pos_left (hu' z) (norm_pos_iff.mpr hc)).trans_eq
      (mul_div_cancel₀ ε (norm_ne_zero_iff.mpr hc))

theorem Approximable.neg (hf : Approximable A f) : Approximable A fun z ↦ -f z := by
  have := hf.const_smul (-1)
  convert this using 1
  ext z
  ring

theorem Approximable.sub (hf : Approximable A f) (hg : Approximable A g) :
    Approximable A fun z ↦ f z - g z := hf.add hg.neg

/-- **Lemma 0 iterated** (lecture 14 p.2): a finite sum of approximable functions is approximable.
This is the step "it suffices to show the approximation claim for each `fⱼ`" of lecture 13 p.2,
where the functions `fⱼ` are the Cauchy transforms of the pieces `Eⱼ` of the cycle `Γ`. -/
theorem Approximable.sum {ι : Type*} {s : Finset ι} {F : ι → ↥K → ℂ} :
    (∀ i ∈ s, Approximable A (F i)) → Approximable A fun z ↦ ∑ i ∈ s, F i z := by
  classical
  refine Finset.induction_on s ?_ ?_
  · intro _
    convert Approximable.zero A using 1
    ext z
    simp
  · intro a s has ih h
    have h1 : Approximable A fun z : ↥K ↦ ∑ i ∈ s, F i z :=
      ih fun i hi ↦ h i (by simp [hi])
    have h2 : Approximable A fun z : ↥K ↦ F a z := by
      convert h a (by simp) using 1
    convert h1.add h2 using 1
    ext z
    rw [Finset.sum_insert has]
    ring

/-- Products with a bounded member of the algebra preserve approximability.  This is the
quantitative form of the fact that the set of approximable functions is closed under multiplication
(the lecturer uses it for `f(z) = c/(z-z₀)^n`, where the multiplier is a power of the generator
`(z - z₀)⁻¹`, which is bounded on `K`). -/
theorem Approximable.mul_of_mem_bounded (hf : Approximable A f) {g : ↥K → ℂ} (hg : g ∈ A)
    {C : ℝ} (hC : 0 ≤ C) (hgC : ∀ z : ↥K, ‖g z‖ ≤ C) : Approximable A fun z ↦ f z * g z := by
  intro ε ε0
  obtain ⟨u, hu, hu'⟩ := hf (ε / (C + 1)) (div_pos ε0 (by linarith))
  refine ⟨fun z ↦ u z * g z, A.mul_mem hu hg, fun z ↦ ?_
  ⟩
  have h0 : 0 ≤ ε / (C + 1) := by positivity
  calc ‖f z * g z - u z * g z‖ = ‖f z - u z‖ * ‖g z‖ := by rw [← sub_mul, norm_mul]
    _ ≤ (ε / (C + 1)) * ‖g z‖ := mul_le_mul_of_nonneg_right (le_of_lt (hu' z)) (norm_nonneg _)
    _ ≤ (ε / (C + 1)) * C := mul_le_mul_of_nonneg_left (hgC z) h0
    _ < (ε / (C + 1)) * (C + 1) := mul_lt_mul_of_pos_left (by linarith) (by positivity)
    _ = ε := div_mul_cancel₀ ε (by linarith)

/-! ## Uniform convergence of sequences: the lecturer's "Lemma 0" and "Lemma 1" -/

/-- The three-point triangle inequality in the form `‖a - c‖ ≤ ‖a - b‖ + ‖b - c‖`. -/
theorem norm_sub_middle (a b c : ℂ) : ‖a - c‖ ≤ ‖a - b‖ + ‖b - c‖ := by
  have := dist_triangle a b c
  rwa [dist_eq_norm, dist_eq_norm, dist_eq_norm] at this

/-- `{F n}` converges uniformly to `f` on `K`, in the ε-N form used in the notes.  See
`tendstoUniformOn_iff_tendstoUniformlyOn` for the translation to Mathlib's `TendstoUniformlyOn`. -/
def TendstoUniformOn (K : Set ℂ) (F : ℕ → ↥K → ℂ) (f : ↥K → ℂ) : Prop :=
  ∀ ε > (0 : ℝ), ∃ N, ∀ n ≥ N, ∀ z : ↥K, ‖F n z - f z‖ < ε

theorem tendstoUniformOn_iff_tendstoUniformlyOn {F : ℕ → ↥K → ℂ} {f : ↥K → ℂ} :
    TendstoUniformOn K F f ↔ TendstoUniformlyOn F f atTop Set.univ := by
  rw [Metric.tendstoUniformlyOn_iff]
  constructor
  · intro h ε ε0
    obtain ⟨N, hN⟩ := h ε ε0
    filter_upwards [Filter.eventually_ge_atTop N] with n hn z _
    rw [dist_eq_norm, norm_sub_rev]
    exact hN n hn z
  · intro h ε ε0
    obtain ⟨N, hN⟩ := (Filter.eventually_atTop (α := ℕ)).1 (h ε ε0)
    exact ⟨N, fun n hn z ↦ by
      have := hN n hn z trivial
      rw [dist_eq_norm, norm_sub_rev] at this
      exact this⟩

theorem tendstoUniformOn_of_tendstoUniformlyOn {F : ℕ → ℂ → ℂ} {f : ℂ → ℂ} {K : Set ℂ}
    (h : TendstoUniformlyOn F f atTop K) :
    TendstoUniformOn K (fun n z ↦ F n (z : ℂ)) fun z ↦ f z := by
  intro ε ε0
  obtain ⟨N, hN⟩ := (Filter.eventually_atTop (α := ℕ)).1 (Metric.tendstoUniformlyOn_iff.1 h ε ε0)
  refine ⟨N, fun n hn z ↦ ?_⟩
  have := hN n hn (z : ℂ) z.2
  rw [dist_eq_norm, norm_sub_rev] at this
  exact this

theorem tendstoUniformOn_const (c : ↥K → ℂ) : TendstoUniformOn K (fun _n ↦ c) c := fun ε ε0 ↦
  ⟨0, fun _n _ z ↦ by simpa using ε0⟩

/-- **Lemma 0** of the notes (lecture 14 p.2): if `{fₙ} → f` and `{gₙ} → g` uniformly on `K`, then
`{fₙ + gₙ} → f + g` uniformly on `K`. -/
theorem TendstoUniformOn.add (hF : TendstoUniformOn K F f) (hG : TendstoUniformOn K G g) :
    TendstoUniformOn K (fun n z ↦ F n z + G n z) fun z ↦ f z + g z := by
  intro ε ε0
  obtain ⟨N1, h1⟩ := hF (ε / 2) (by positivity)
  obtain ⟨N2, h2⟩ := hG (ε / 2) (by positivity)
  exact ⟨max N1 N2, fun n hn z ↦ by
    have e1 := h1 n (le_trans (Nat.le_max_left _ _) hn) z
    have e2 := h2 n (le_trans (Nat.le_max_right _ _) hn) z
    have h3 : ‖(F n z + G n z) - (f z + g z)‖ ≤ ‖F n z - f z‖ + ‖G n z - g z‖ := by
      rw [show (F n z + G n z) - (f z + g z) = (F n z - f z) + (G n z - g z) by abel_nf]
      exact norm_add_le _ _
    exact h3.trans_lt (by linarith)⟩

/-- Scalar multiples of uniformly convergent sequences. -/
theorem TendstoUniformOn.const_smul (c : ℂ) (hF : TendstoUniformOn K F f) :
    TendstoUniformOn K (fun n z ↦ c • F n z) fun z ↦ c • f z := by
  by_cases hc : c = 0
  · subst hc
    convert tendstoUniformOn_const _ using 1
    ext n z
    simp
  · intro ε ε0
    obtain ⟨N, hN⟩ := hF (ε / ‖(c : ℂ)‖) (div_pos ε0 (norm_pos_iff.mpr hc))
    exact ⟨N, fun n hn z ↦ by
      change ‖c • F n z - c • f z‖ < ε
      rw [← smul_sub, norm_smul]
      exact (mul_lt_mul_of_pos_left (hN n hn z) (norm_pos_iff.mpr hc)).trans_eq
        (mul_div_cancel₀ ε (norm_ne_zero_iff.mpr hc))⟩

theorem TendstoUniformOn.const_mul (c : ℂ) (hF : TendstoUniformOn K F f) :
    TendstoUniformOn K (fun n z ↦ F n z * c) fun z ↦ f z * c := by
  have h1 : (fun n z ↦ F n z * c) = fun n z ↦ c • F n z := by
    funext n z
    exact mul_comm _ _
  have h2 : (fun z ↦ f z * c) = fun z ↦ c • f z := by
    funext z
    exact mul_comm _ _
  rw [h1, h2]
  exact hF.const_smul c

theorem TendstoUniformOn.neg (hF : TendstoUniformOn K F f) :
    TendstoUniformOn K (fun n z ↦ -F n z) fun z ↦ -f z := fun ε ε0 ↦ by
  obtain ⟨N, hN⟩ := hF ε ε0
  exact ⟨N, fun n hn z ↦ by rw [neg_sub_neg, norm_sub_rev]; exact hN n hn z⟩

theorem TendstoUniformOn.sub (hF : TendstoUniformOn K F f) (hG : TendstoUniformOn K G g) :
    TendstoUniformOn K (fun n z ↦ F n z - G n z) fun z ↦ f z - g z := hF.add hG.neg

/-- The Archimedean estimate used in the diagonal argument. -/
theorem exists_nat_one_div_lt (a : ℝ) (a0 : 0 < a) : ∃ S : ℕ, ∀ n ≥ S, (1 : ℝ) / (n + 2) < a := by
  obtain ⟨M, hM⟩ : ∃ M : ℕ, a⁻¹ < M := exists_nat_gt _
  have hM0 : (0 : ℝ) < M := lt_of_lt_of_le (inv_pos.mpr a0) (le_of_lt hM)
  refine ⟨M, fun n hn ↦ ?_⟩
  have hn0 : (0 : ℝ) < n + 2 := by positivity
  have h1 : (1 : ℝ) / (n + 2) ≤ 1 / M :=
    (one_div_le_one_div hn0 (by linarith)).mpr (by exact_mod_cast (by linarith : M ≤ n + 2))
  have h2 : (1 : ℝ) / M < a := by
    have hMa : (1 : ℝ) < a * M := by
      have := mul_lt_mul_of_pos_left hM a0
      rwa [mul_inv_cancel₀ (ne_of_gt a0)] at this
    rw [div_lt_iff₀ (by linarith : (0 : ℝ) < M)]
    linarith
  exact lt_of_le_of_lt h1 h2

/-- **Lemma 1** of the notes (lecture 14 p.2, the diagonal / "double sequence" argument): if
`{fₙ} → f` uniformly on `K` and for each `n` there is a sequence `{g⁽ⁿ⁾ⱼ} → fₙ` uniformly on `K`,
then a diagonal subsequence `{g⁽ⁿ⁾_{φ(n)}}` converges to `f` uniformly on `K`. -/
theorem exists_tendstoUniformOn_diag {Φ : ℕ → ↥K → ℂ} {G : ℕ → ℕ → ↥K → ℂ} {f : ↥K → ℂ}
    (hF : TendstoUniformOn K Φ f) (hG : ∀ n, TendstoUniformOn K (G n) (Φ n)) :
    ∃ φ : ℕ → ℕ, TendstoUniformOn K (fun n ↦ G n (φ n)) f := by
  -- The lecturer's choice: for the `n`-th row of the double sequence pick an index beyond which
  -- `G n j` is `1/(n+2)`-close to `F n`.
  have hG' : ∀ n, ∃ M, ∀ j ≥ M, ∀ z : ↥K, ‖G n j z - Φ n z‖ < 1 / (n + 2 : ℝ) := fun n ↦
    hG n (1 / (n + 2 : ℝ)) (by positivity)
  choose φ hφ using hG'
  refine ⟨φ, fun ε ε0 ↦ ?_⟩
  obtain ⟨S1, hS1⟩ := hF (ε / 2) (by positivity)
  obtain ⟨S2, hS2⟩ := exists_nat_one_div_lt (ε / 2) (by positivity)
  refine ⟨max S1 S2, fun n hn z ↦ ?_⟩
  have h1 : ‖Φ n z - f z‖ < ε / 2 := hS1 n (le_trans (Nat.le_max_left _ _) hn) z
  have h2 : ‖G n (φ n) z - Φ n z‖ < 1 / (n + 2 : ℝ) := hφ n (φ n) (le_refl _) z
  have h3 : (1 : ℝ) / (n + 2) < ε / 2 := hS2 n (le_trans (Nat.le_max_right _ _) hn)
  calc ‖G n (φ n) z - f z‖ ≤ ‖G n (φ n) z - Φ n z‖ + ‖Φ n z - f z‖ := norm_sub_middle _ _ _
    _ < 1 / (n + 2 : ℝ) + ε / 2 := by linarith
    _ < ε / 2 + ε / 2 := by gcongr
    _ = ε := by ring

/-- **Lemma 1** (consequence used in the notes): the set `B(E)` of approximable functions is closed
under uniform limits. -/
theorem tendstoUniformlyOn_approximable {F : ℕ → ↥K → ℂ} {f : ↥K → ℂ}
    (hF : TendstoUniformOn K F f) (hA : ∀ n, Approximable A (F n)) : Approximable A f := by
  intro ε ε0
  obtain ⟨N, hN⟩ := hF (ε / 2) (by positivity)
  obtain ⟨g, hg, hgz⟩ := hA N (ε / 2) (by positivity)
  exact ⟨g, hg, fun z ↦ by
    have h1 : ‖f z - F N z‖ < ε / 2 := by
      rw [norm_sub_rev]
      exact hN N (le_refl _) z
    calc ‖f z - g z‖ ≤ ‖f z - F N z‖ + ‖F N z - g z‖ := norm_sub_middle _ _ _
      _ < ε / 2 + ε / 2 := by linarith [h1, hgz z]
      _ = ε := by ring⟩

/-! ## The component condition on the pole set -/

/-- The "by taking `ε = 1/n`" note of lecture 13 p.1: `Approximable A f` gives a *sequence* of
elements of `A` converging uniformly on `K` to `f` (what the lecturer calls a sequence "which
converges normally on `K` to `f`"). -/
theorem exists_tendstoUniformOn_approximable {f : ↥K → ℂ} (hf : Approximable A f) :
    ∃ F : ℕ → A, TendstoUniformOn K (fun n z ↦ (F n : ↥K → ℂ) z) f := by
  have h1 : ∀ n : ℕ, ∃ g : A, ∀ z : ↥K, ‖(g : ↥K → ℂ) z - f z‖ < 1 / ((n : ℝ) + 2) := by
    intro n
    have h2 : (0 : ℝ) < (n : ℝ) + 2 := by
      have h3 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
      linarith
    obtain ⟨g, hg, hgz⟩ := hf (1 / ((n : ℝ) + 2)) (div_pos zero_lt_one h2)
    exact ⟨⟨g, hg⟩, fun z ↦ by rw [norm_sub_rev]; exact hgz z⟩
  choose F hF using h1
  refine ⟨F, fun ε ε0 ↦ ?_⟩
  obtain ⟨S, hS⟩ := exists_nat_one_div_lt ε ε0
  exact ⟨S, fun n hn z ↦ lt_of_lt_of_le (hF n z) (le_of_lt (hS n hn))⟩

/-- `BoundedSet s`: the set `s ⊆ ℂ` is contained in a disc.  In the notes, the only component of
`ℂ − K` that does not have to meet the finite pole set `E` is the unbounded one, i.e. the one that
contains `∞ ∈ ℂ∞`. -/
def BoundedSet (s : Set ℂ) : Prop := ∃ R, ∀ z ∈ s, ‖z‖ < R

/-- `MeetsComponents K E atInfinity`: the set `E ∪ {∞ if atInfinity}` of allowed poles meets every
component of `ℂ∞ − K`.

Since `K` is compact, the components of `ℂ∞ − K` are the bounded components of `ℂ − K` together
with the component containing `∞`; so the condition reads: every component `C` of `ℂ − K` contains
a point of `E`, unless `∞` is an allowed pole (`atInfinity`).

The lecturer's gloss (lecture 13 p.1): "`E` has a point in each 'hole' of `K` and `E` has a
point near `∞` in `ℂ∞` (usually just take `∞` itself)". -/
def MeetsComponents (K E : Set ℂ) (atInfinity : Bool) : Prop :=
  ∀ w ∈ Kᶜ,
    (connectedComponentIn Kᶜ w ∩ E).Nonempty ∨
      (atInfinity ∧ ¬BoundedSet (connectedComponentIn Kᶜ w))

/-- The pole set `E = ℂ − K`, together with `∞`, satisfies the component condition: this is the
`E = ℂ∞ − K` case of the weak Runge theorem (lecture 13 p.2). -/
theorem meetsComponents_complement (K : Set ℂ) : MeetsComponents K Kᶜ true := fun w hw ↦
  Or.inl ⟨w, Set.mem_inter (mem_connectedComponentIn hw) hw⟩

/-! ## The ℂ-algebra of bounded functions on `K`

Boundedness is needed for the "the functions that can be approximated form an algebra" step of the
lecturer's proof of Lemma 0/1 (lecture 14 p.2): if `f` is a uniform limit of members of `A` and
`g` is another such limit, then `f * (G n)` approximates `f * g`, and for that one needs a bound
for `f` that is uniform on `K`.  Since `Continuous` is only a pointwise statement here, the bound is
recorded explicitly, as `BoundedOn`. -/

/-- `BoundedOn K f`: there is `C` with `‖f z‖ ≤ C` on `K`. -/
def BoundedOn (K : Set ℂ) (f : ↥K → ℂ) : Prop := ∃ C, 0 ≤ C ∧ ∀ z : ↥K, ‖f z‖ ≤ C

/-- The ℂ-subalgebra of bounded functions on `K`. -/
def BoundedAlg (K : Set ℂ) : Subalgebra ℂ (↥K → ℂ) where
  carrier := BoundedOn K
  add_mem' := by
    rintro f g ⟨C, hC0, hC⟩ ⟨D, hD0, hD⟩
    exact ⟨C + D, by positivity, fun z ↦ (norm_add_le _ _).trans (add_le_add (hC z) (hD z))⟩
  mul_mem' := by
    rintro f g ⟨C, hC0, hC⟩ ⟨D, hD0, hD⟩
    refine ⟨C * D, mul_nonneg hC0 hD0, fun z ↦ ?_⟩
    change ‖f z * g z‖ ≤ C * D
    exact (le_of_eq (norm_mul _ _)).trans
      ((mul_le_mul_of_nonneg_right (hC z) (norm_nonneg _)).trans
        (mul_le_mul_of_nonneg_left (hD z) hC0))
  algebraMap_mem' := fun c ↦ ⟨‖(c : ℂ)‖, norm_nonneg _, fun z ↦ by
    have h1 : (algebraMap ℂ (↥K → ℂ) c : ↥K → ℂ) z = (c : ℂ) := by simp
    rw [h1]⟩

theorem BoundedOn.mem_BoundedAlg {f : ↥K → ℂ} (hf : BoundedOn K f) : f ∈ BoundedAlg K := hf

/-- The coordinate function is bounded on a compact set. -/
theorem boundedOn_coord (hK : IsCompact K) : BoundedOn K (coord K) := by
  have h2 : IsCompact ((fun z : ℂ => ‖(z : ℂ)‖) '' K) :=
    hK.image_of_continuousOn (continuous_norm.continuousOn : ContinuousOn (fun z : ℂ => ‖z‖) K)
  obtain ⟨C, hC⟩ := h2.bddAbove
  refine ⟨max C 0, le_max_right _ _, fun z ↦ ?_⟩
  exact ((hC (Set.mem_image_of_mem (fun z : ℂ => ‖z‖) z.2))).trans (le_max_left _ _)

/-- The generator `z ↦ (z - a)⁻¹` is bounded on a compact set that does not contain `a`. -/
theorem boundedOn_invSub (hK : IsCompact K) {a : ℂ} (ha : a ∉ K) : BoundedOn K (invSub a K) := by
  obtain ⟨δ, δ0, hδ⟩ := Metric.isOpen_iff.mp hK.isClosed.isOpen_compl a ha
  refine ⟨δ⁻¹, by positivity, fun z ↦ ?_⟩
  have h2 : δ ≤ ‖(z : ℂ) - a‖ := by
    by_contra h3
    have h4 : (z : ℂ) ∈ ball a δ := by
      rw [Metric.mem_ball, dist_eq_norm]
      exact lt_of_not_ge h3
    exact hδ h4 z.2
  calc ‖invSub a K z‖ = ‖((z : ℂ) - a)⁻¹‖ := rfl
    _ = ‖(z : ℂ) - a‖⁻¹ := norm_inv _
    _ ≤ δ⁻¹ := (inv_le_inv₀ (by linarith) δ0).mpr h2

/-- The polynomial functions on `K` are bounded: `K` is compact. -/
theorem Polys.le_boundedAlg (hK : IsCompact K) : Polys K ≤ BoundedAlg K :=
  Algebra.adjoin_le (Set.singleton_subset_iff.mpr ((boundedOn_coord hK).mem_BoundedAlg))

/-- The rational functions with only a pole at `q` are bounded on a compact set that misses `q`. -/
theorem PoleAt.le_boundedAlg (hK : IsCompact K) {q : ℂ} (hq : q ∉ K) :
    PoleAt q K ≤ BoundedAlg K :=
  Algebra.adjoin_le (Set.singleton_subset_iff.mpr ((boundedOn_invSub hK hq).mem_BoundedAlg))

/-- The rational functions with poles in `E` are bounded on a compact set that misses `E`. -/
theorem RatAlg.le_boundedAlg (hK : IsCompact K) (hE : ∀ a ∈ E, a ∉ K) :
    RatAlg E K ≤ BoundedAlg K :=
  Algebra.adjoin_le (Set.image_subset_iff.mpr fun a ha ↦
    (boundedOn_invSub hK (hE a ha)).mem_BoundedAlg)

/-- The rational functions with poles in `E ∪ {∞}` are bounded on a compact set missing `E`. -/
theorem RatAlgInf.le_boundedAlg (hK : IsCompact K) (hE : ∀ a ∈ E, a ∉ K) :
    RatAlgInf E K ≤ BoundedAlg K :=
  Algebra.adjoin_le (Set.union_subset
    (Set.image_subset_iff.mpr fun a ha ↦ (boundedOn_invSub hK (hE a ha)).mem_BoundedAlg)
    (Set.singleton_subset_iff.mpr ((boundedOn_coord hK).mem_BoundedAlg)))

/-- A uniform limit of bounded functions is bounded: this is where the lecturer's "the sequence
`{Rₙ}` is uniformly bounded on `K`" comes from. -/
theorem BoundedOn.of_approximable (hA : A ≤ BoundedAlg K) (hf : Approximable A f) :
    BoundedOn K f := by
  obtain ⟨u, hu, hu'⟩ := hf 1 zero_lt_one
  obtain ⟨C, hC0, hC⟩ := hA hu
  refine ⟨C + 1, by positivity, fun z ↦ ?_⟩
  have h1 : ‖f z - u z‖ + ‖u z‖ ≤ 1 + C := by linarith [hu' z, hC z]
  have h2 : ‖f z‖ ≤ ‖f z - u z‖ + ‖u z‖ := by
    have := norm_sub_middle (f z) (u z) 0
    simpa using this
  exact h2.trans (h1.trans (by linarith))

/-- The product of two approximable functions is approximable, provided the algebra consists of
bounded functions: this is the "the set of functions that can be approximated is an algebra" step
(Lemma 0 plus the boundedness of the generators off `K`) of lecture 14 p.2. -/
theorem Approximable.mul (hf : Approximable A f) (hg : Approximable A g)
    (hA : A ≤ BoundedAlg K) : Approximable A fun z ↦ f z * g z := by
  obtain ⟨C, hC0, hCf⟩ := BoundedOn.of_approximable hA hf
  obtain ⟨G, hG⟩ := exists_tendstoUniformOn_approximable hg
  have h1 : ∀ n : ℕ, Approximable A fun z ↦ f z * (G n : ↥K → ℂ) z := by
    intro n
    obtain ⟨D, hD0, hDn⟩ := hA (G n).2
    exact hf.mul_of_mem_bounded (G n).2 hD0 hDn
  refine tendstoUniformlyOn_approximable ?_ h1
  intro ε ε0
  obtain ⟨N, hN⟩ := hG (ε / (C + 1)) (div_pos ε0 (by linarith))
  refine ⟨N, fun n hn z ↦ ?_⟩
  have h2 : ‖(G n : ↥K → ℂ) z - g z‖ < ε / (C + 1) := hN n hn z
  have h3 : ‖f z * (G n : ↥K → ℂ) z - f z * g z‖ = ‖f z‖ * ‖(G n : ↥K → ℂ) z - g z‖ := by
    rw [show f z * (G n : ↥K → ℂ) z - f z * g z = f z * ((G n : ↥K → ℂ) z - g z) by ring,
      norm_mul]
  have h4 : ‖f z‖ * (ε / (C + 1)) < ε := by
    have hq : (0 : ℝ) < ε / (C + 1) := div_pos ε0 (by linarith)
    have h7 : ‖f z‖ * (ε / (C + 1)) ≤ C * (ε / (C + 1)) :=
      mul_le_mul_of_nonneg_right (hCf z) (le_of_lt hq)
    have h8 : C * (ε / (C + 1)) < (C + 1) * (ε / (C + 1)) :=
      mul_lt_mul_of_pos_right (by linarith) hq
    have h9 : (C + 1 : ℝ) * (ε / (C + 1)) = ε := by
      rw [mul_comm, div_mul_cancel₀ ε (by linarith : (C + 1 : ℝ) ≠ 0)]
    linarith
  calc ‖f z * (G n : ↥K → ℂ) z - f z * g z‖
      = ‖f z‖ * ‖(G n : ↥K → ℂ) z - g z‖ := h3
    _ ≤ ‖f z‖ * (ε / (C + 1)) := mul_le_mul_of_nonneg_left (le_of_lt h2) (norm_nonneg _)
    _ < ε := h4

/-- The ℂ-subalgebra of the functions that can be uniformly approximated on `K` by members of `A`:
the set `B(E)` of Conway VIII.1.8 and of the lecturer's Lemma 0/1 argument. -/
def approximableSubalgebra (A : Subalgebra ℂ (↥K → ℂ)) (hA : A ≤ BoundedAlg K) :
    Subalgebra ℂ (↥K → ℂ) where
  carrier := Approximable A
  add_mem' := fun hf hg ↦ Approximable.add hf hg
  mul_mem' := fun hf hg ↦ Approximable.mul hf hg hA
  algebraMap_mem' := fun c ↦ approximable_const A c

theorem mem_approximableSubalgebra {hA : A ≤ BoundedAlg K} {f : ↥K → ℂ} :
    f ∈ approximableSubalgebra A hA ↔ Approximable A f := Iff.rfl

/-- **Transitivity of approximation**: the "double sequence" argument of Lemma 1 in the form used by
the pole pushing chain. -/
theorem Approximable.trans {C : Subalgebra ℂ (↥K → ℂ)}
    (hCA : ∀ g ∈ C, Approximable A g) (hf : Approximable C f) : Approximable A f := by
  intro ε ε0
  obtain ⟨v, hv, hv'⟩ := hf (ε / 2) (by linarith)
  obtain ⟨u, hu, hu'⟩ := hCA v hv (ε / 2) (by linarith)
  refine ⟨u, hu, fun z ↦ ?_⟩
  calc ‖f z - u z‖ ≤ ‖f z - v z‖ + ‖v z - u z‖ := norm_sub_middle _ _ _
    _ < ε / 2 + ε / 2 := by linarith [hv' z, hu' z]
    _ = ε := by ring

/-- Powers of an approximable function are approximable: this handles the lecturer's
`f(z) = c / (z - z₀)^n`. -/
theorem Approximable.pow {hA : A ≤ BoundedAlg K} (hf : Approximable A f) (n : ℕ) :
    Approximable A fun z ↦ f z ^ n := by
  induction n with
  | zero =>
      convert Approximable.one A using 1
      ext z
      simp
  | succ n ih =>
      convert ih.mul hf hA using 1
      ext z
      rw [pow_succ]

/-- The polynomial functions `z ↦ (z - a)^n` on `K`: the partial sums of the Taylor expansion of
the case `w = ∞` of the pole pushing lemma. -/
theorem Polys.pow_sub_algebraMap_mem (a : ℂ) (n : ℕ) :
    (fun z : ↥K ↦ ((z : ℂ) - a) ^ n) ∈ Polys K :=
  Subalgebra.pow_mem _ (Subalgebra.sub_mem _ Polys.mem_of_mem
    (Subalgebra.algebraMap_mem _ _)) n

end

